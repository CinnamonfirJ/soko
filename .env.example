# Server-side secrets. Copy to .env.local. Never expose to the client.
SOKO_SIGNING_SECRET=change-me-long-random-string
SOKO_WEBHOOK_SECRET=change-me-webhook-secret
# Ops console access key (role gate for /ops). Change before sharing.
SOKO_OPS_KEY=ops-access-key
# Optional: enables LLM intent extraction in Soko Assistant. Falls back to the deterministic parser.
ANTHROPIC_API_KEY=
# WhatsApp channel: shared secret the orchestrator (n8n / WhatsApp Business provider) sends as x-soko-channel-secret.
SOKO_WHATSAPP_SECRET=change-me-whatsapp-secret
# Public base URL used in links sent over WhatsApp, e.g. https://sokobot.app
SOKO_PUBLIC_URL=
